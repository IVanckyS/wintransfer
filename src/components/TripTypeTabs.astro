---
/**
 * Pestañas de tipo de viaje (Hacia aeropuerto / Desde aeropuerto / Otro
 * traslado) con íconos minimalistas. Compartidas por SmartForm y
 * MiniBookingForm: ambos scripts escuchan input[name="trip-type"].
 *
 * Íconos: Lucide (lucide.dev, licencia ISC) — plane-takeoff,
 * plane-landing y car-front (rect convertido a path).
 */
import { getLangFromUrl, useTranslations } from '../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const OPTIONS = [
  {
    value: 'to-airport',
    label: t('form.tripToAirport'),
    paths: [
      'M2 22h20',
      'M6.36 17.4 4 17l-2-4 1.1-.55a2 2 0 0 1 1.8 0l.17.1a2 2 0 0 0 1.8 0L8 12 5 6l.9-.45a2 2 0 0 1 2.09.2l4.02 3a2 2 0 0 0 2.1.2l4.19-2.06a2.41 2.41 0 0 1 1.73-.17L21 7a1.4 1.4 0 0 1 .87 1.99l-.38.76c-.23.46-.6.84-1.07 1.08L7.58 17.2a2 2 0 0 1-1.22.18Z',
    ],
  },
  {
    value: 'from-airport',
    label: t('form.tripFromAirport'),
    paths: [
      'M2 22h20',
      'M3.77 10.77 2 9l2-4.5 1.1.55c.55.28.9.84.9 1.45s.35 1.17.9 1.45L8 8.5l3-6 1.05.53a2 2 0 0 1 1.09 1.52l.72 5.4a2 2 0 0 0 1.09 1.52l4.4 2.2c.42.22.78.55 1.01.96l.6 1.03c.49.88-.06 1.98-1.06 2.1l-1.18.15c-.47.06-.95-.02-1.37-.24L4.29 11.15a2 2 0 0 1-.52-.38Z',
    ],
  },
  {
    value: 'other',
    label: t('form.tripOther'),
    paths: [
      'm21 8-2 2-1.5-3.7A2 2 0 0 0 15.646 5H8.4a2 2 0 0 0-1.903 1.257L5 10 3 8',
      'M7 14h.01',
      'M17 14h.01',
      'M5 10h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2Z',
      'M5 18v2',
      'M19 18v2',
    ],
  },
];
---

<div class:list={['grid grid-cols-3 gap-1.5 rounded-2xl bg-mist p-1.5', className]} role="radiogroup">
  {
    OPTIONS.map((option, i) => (
      <label class="cursor-pointer">
        <input type="radio" name="trip-type" value={option.value} data-msg={option.label} checked={i === 0} class="peer sr-only" />
        <span class="flex h-full flex-col items-center justify-center gap-1.5 rounded-xl px-1.5 py-2.5 text-center text-xs font-bold text-primary transition-colors peer-checked:bg-primary peer-checked:text-white hover:bg-white sm:text-[13px]">
          <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 stroke-current" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {option.paths.map((d) => (
              <path d={d} />
            ))}
          </svg>
          {option.label}
        </span>
      </label>
    ))
  }
</div>
