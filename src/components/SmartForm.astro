---
/**
 * Formulario inteligente: un solo formulario con selector
 * Reserva / Convenio / Trabaja con nosotros.
 * Al enviar arma un mensaje con todos los campos y abre WhatsApp
 * (número en src/config.ts → WHATSAPP_NUMBER).
 */
import TripTypeTabs from './TripTypeTabs.astro';
import PhoneField from './PhoneField.astro';
import { getLangFromUrl, useTranslations } from '../i18n';
import { WHATSAPP_NUMBER } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const paymentOptions = t<string[]>('form.paymentOptions');

const inputClass =
  'w-full rounded-xl border border-primary/20 bg-white px-4 py-3 text-sm text-ink transition-colors placeholder:text-ink/40 hover:border-primary/40 focus:border-action-bright focus:ring-2 focus:ring-accent/40 focus:outline-none';
const labelClass = 'mb-1.5 block text-sm font-semibold text-ink';
---

<form
  id="smart-form"
  class="scroll-mt-28 rounded-3xl border border-primary/10 bg-white p-6 shadow-xl shadow-primary/5 md:p-8"
  data-wa-number={WHATSAPP_NUMBER}
  data-intro-booking={t('form.waIntroBooking')}
  data-intro-agreement={t('form.waIntroAgreement')}
  data-intro-jobs={t('form.waIntroJobs')}
  data-label-outbound={t('form.outbound')}
  data-label-return={t('form.return')}
  data-label-passengers={t('form.passengers')}
  data-label-luggage={t('form.luggage')}
  data-summary-empty={t('form.summaryEmpty')}
  data-err-required={t('form.fieldRequired')}
  data-airport-placeholder={t('form.airportPlaceholder')}
  data-err-name={t('form.errName')}
  data-err-phone={t('form.errPhone')}
  data-err-phone-cl={t('form.errPhoneCl')}
  data-err-airport={t('form.errAirport')}
  data-err-passengers={t('form.errPassengers')}
  data-err-luggage={t('form.errLuggage')}
>
  <fieldset>
    <legend class="font-display text-lg font-bold text-primary">{t('form.title')}</legend>
    <div class="mt-4 grid grid-cols-1 gap-2 rounded-2xl bg-mist p-2 sm:grid-cols-3" role="radiogroup">
      {
        [
          { value: 'booking', label: t('form.typeBooking') },
          { value: 'agreement', label: t('form.typeAgreement') },
          { value: 'jobs', label: t('form.typeJobs') },
        ].map((option, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="form-type" value={option.value} checked={i === 0} class="peer sr-only" />
            <span class="block rounded-xl px-4 py-2.5 text-center text-sm font-bold text-primary transition-colors peer-checked:bg-primary peer-checked:text-white hover:bg-white">
              {option.label}
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <!-- Reserva (flujo estilo Transvip: tipo de viaje → tramos → pasajeros → resumen) -->
  <fieldset data-panel="booking" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <!-- Tipo de viaje: prellena el aeropuerto como origen o destino -->
    <TripTypeTabs class="sm:col-span-2" />

    <!-- Solo ida / ida y vuelta -->
    <div class="flex flex-wrap gap-2 sm:col-span-2" role="radiogroup">
      {
        [
          { value: 'one-way', label: t('form.oneWay') },
          { value: 'round-trip', label: t('form.roundTrip') },
        ].map((option, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="trip-mode" value={option.value} data-msg={option.label} checked={i === 0} class="peer sr-only" />
            <span class="block rounded-full border border-primary/20 px-4 py-1.5 text-xs font-bold text-primary transition-colors peer-checked:border-primary peer-checked:bg-primary peer-checked:text-white">
              {option.label}
            </span>
          </label>
        ))
      }
    </div>
    <div class="relative">
      <label class={labelClass} for="f-origin">{t('form.origin')}</label>
      <input
        id="f-origin"
        name="origin"
        data-label={t('form.origin')}
        data-autocomplete
        autocomplete="off"
        aria-autocomplete="list"
        maxlength="80"
        required
        placeholder={t('form.originPlaceholder')}
        class={inputClass}
      />
    </div>
    <div class="relative">
      <label class={labelClass} for="f-destination">{t('form.destination')}</label>
      <input
        id="f-destination"
        name="destination"
        data-label={t('form.destination')}
        data-autocomplete
        autocomplete="off"
        aria-autocomplete="list"
        maxlength="80"
        required
        placeholder={t('form.destinationPlaceholder')}
        class={inputClass}
      />
    </div>
    <div>
      <label class={labelClass} for="f-date">{t('form.date')}</label>
      <input id="f-date" name="date" type="date" data-label={t('form.date')} required class={inputClass} />
    </div>
    <div>
      <label class={labelClass} for="f-time">{t('form.time')}</label>
      <input id="f-time" name="time" type="time" data-label={t('form.time')} required class={inputClass} />
    </div>

    <!-- Regreso (solo con "ida y vuelta") -->
    <div data-return hidden>
      <label class={labelClass} for="f-return-date">{t('form.returnDate')}</label>
      <input id="f-return-date" name="return-date" type="date" data-label={t('form.returnDate')} disabled class={inputClass} />
    </div>
    <div data-return hidden>
      <label class={labelClass} for="f-return-time">{t('form.returnTime')}</label>
      <input id="f-return-time" name="return-time" type="time" data-label={t('form.returnTime')} disabled class={inputClass} />
    </div>

    <div>
      <label class={labelClass} for="f-passengers">{t('form.passengers')}</label>
      <div class="flex items-center gap-2">
        <button type="button" data-stepper="-1" data-target="f-passengers" aria-label="−" class="h-11 w-11 shrink-0 rounded-xl border border-primary/20 font-display text-lg font-bold text-primary transition-colors hover:bg-mist">−</button>
        <input id="f-passengers" name="passengers" type="number" inputmode="numeric" min="1" max="15" step="1" value="1" data-label={t('form.passengers')} data-validate="passengers" required class={`${inputClass} text-center`} />
        <button type="button" data-stepper="1" data-target="f-passengers" aria-label="+" class="h-11 w-11 shrink-0 rounded-xl border border-primary/20 font-display text-lg font-bold text-primary transition-colors hover:bg-mist">+</button>
      </div>
    </div>
    <div>
      <label class={labelClass} for="f-luggage">{t('form.luggage')}</label>
      <div class="flex items-center gap-2">
        <button type="button" data-stepper="-1" data-target="f-luggage" aria-label="−" class="h-11 w-11 shrink-0 rounded-xl border border-primary/20 font-display text-lg font-bold text-primary transition-colors hover:bg-mist">−</button>
        <input id="f-luggage" name="luggage" type="number" inputmode="numeric" min="0" max="20" step="1" value="0" data-label={t('form.luggage')} data-validate="luggage" class={`${inputClass} text-center`} />
        <button type="button" data-stepper="1" data-target="f-luggage" aria-label="+" class="h-11 w-11 shrink-0 rounded-xl border border-primary/20 font-display text-lg font-bold text-primary transition-colors hover:bg-mist">+</button>
      </div>
    </div>

    <div>
      <label class={labelClass} for="f-name">{t('form.passengerName')}</label>
      <input id="f-name" name="name" data-label={t('form.passengerName')} data-validate="name" maxlength="60" required placeholder={t('form.namePlaceholder')} class={inputClass} />
    </div>
    <PhoneField id="f-phone" name="phone" label={t('form.contactPhone')} />
    <div class="sm:col-span-2">
      <label class={labelClass} for="f-payment">{t('form.payment')}</label>
      <select id="f-payment" name="payment" data-label={t('form.payment')} required class={inputClass}>
        <option value="" disabled selected>{t('form.paymentPlaceholder')}</option>
        {paymentOptions.map((option) => <option value={option}>{option}</option>)}
      </select>
    </div>

    <!-- Resumen en vivo del viaje -->
    <div class="rounded-2xl border border-primary/10 bg-mist p-4 sm:col-span-2">
      <p class="font-display text-sm font-bold text-primary">{t('form.summaryTitle')}</p>
      <p id="booking-summary" class="mt-1.5 text-sm whitespace-pre-line text-ink/70">{t('form.summaryEmpty')}</p>
    </div>
  </fieldset>

  <!-- Convenio -->
  <fieldset data-panel="agreement" class="mt-6 hidden grid-cols-1 gap-4" disabled>
    <div>
      <label class={labelClass} for="f-company">{t('form.companyName')}</label>
      <input id="f-company" name="company" data-label={t('form.companyName')} maxlength="80" required placeholder={t('form.companyPlaceholder')} class={inputClass} />
    </div>
    <div>
      <label class={labelClass} for="f-contact">{t('form.contactPerson')}</label>
      <input id="f-contact" name="contact" data-label={t('form.contactPerson')} maxlength="80" required placeholder={t('form.contactPlaceholder')} class={inputClass} />
    </div>
    <div>
      <label class={labelClass} for="f-message">{t('form.message')}</label>
      <textarea id="f-message" name="message" data-label={t('form.message')} maxlength="600" required rows="4" placeholder={t('form.messagePlaceholder')} class={inputClass}></textarea>
    </div>
  </fieldset>

  <!-- Trabaja con nosotros (sin subida de archivos) -->
  <fieldset data-panel="jobs" class="mt-6 hidden grid-cols-1 gap-4" disabled>
    <div>
      <label class={labelClass} for="f-job-name">{t('form.name')}</label>
      <input id="f-job-name" name="job-name" data-label={t('form.name')} data-validate="name" maxlength="60" required placeholder={t('form.namePlaceholder')} class={inputClass} />
    </div>
    <PhoneField id="f-job-phone" name="job-phone" label={t('form.phone')} />
    <div>
      <label class={labelClass} for="f-experience">{t('form.experience')}</label>
      <textarea id="f-experience" name="experience" data-label={t('form.experience')} maxlength="600" required rows="4" placeholder={t('form.experiencePlaceholder')} class={inputClass}></textarea>
      <p class="mt-2 text-xs text-ink/70">{t('form.jobsNote')}</p>
    </div>
  </fieldset>

  <button
    type="submit"
    class="mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-wa px-6 py-4 font-display font-bold text-white transition-transform hover:scale-[1.02]"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M12 2a9.9 9.9 0 0 0-8.5 15.1L2 22l5-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1a17 17 0 0 1-1.7-.6c-3-1.3-5-4.4-5.1-4.6-.1-.2-1.2-1.6-1.2-3.1 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l1 2.3c0 .2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.1.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.2.5.1.7-.1l.9-1c.2-.3.4-.3.7-.2l2.2 1c.3.2.5.3.6.4.1.2.1.7-.2 1.2Z"/></svg>
    {t('form.submit')}
  </button>
  <p class="mt-3 text-center text-xs text-ink/70">{t('form.disclaimer')}</p>
</form>

<style>
  /* Ícono nativo de calendario/reloj: más grande, color de marca y zona clicable clara */
  input[type='date']::-webkit-calendar-picker-indicator,
  input[type='time']::-webkit-calendar-picker-indicator {
    cursor: pointer;
    width: 1.2rem;
    height: 1.2rem;
    padding: 2px;
    border-radius: 0.4rem;
    filter: invert(16%) sepia(83%) saturate(3164%) hue-rotate(217deg) brightness(91%) contrast(101%);
    transition: background-color 0.15s ease;
  }
  input[type='date']::-webkit-calendar-picker-indicator:hover,
  input[type='time']::-webkit-calendar-picker-indicator:hover {
    background-color: rgb(0 57 174 / 0.12);
  }
  /* Texto de fecha/hora en el tono tinta de la marca */
  input[type='date']::-webkit-datetime-edit,
  input[type='time']::-webkit-datetime-edit {
    color: var(--color-ink);
  }

  /* Campo con error (validación propia, en lugar del globo del navegador) */
  .is-invalid {
    border-color: rgb(220 38 38) !important;
  }
  .is-invalid:focus {
    box-shadow: 0 0 0 2px rgb(220 38 38 / 0.25) !important;
  }
</style>

<script>
  import { LOCATIONS } from '../data/locations';
  import { COUNTRY_CODES } from '../data/countryCodes';

  const form = document.getElementById('smart-form') as HTMLFormElement;
  const panels = form.querySelectorAll<HTMLFieldSetElement>('[data-panel]');
  const radios = form.querySelectorAll<HTMLInputElement>('input[name="form-type"]');

  function activePanelType(): string {
    return form.querySelector<HTMLInputElement>('input[name="form-type"]:checked')?.value ?? 'booking';
  }

  function showPanel(type: string) {
    panels.forEach((panel) => {
      const active = panel.dataset.panel === type;
      panel.classList.toggle('hidden', !active);
      panel.classList.toggle('grid', active);
      // Deshabilitar paneles ocultos para que sus "required" no bloqueen el envío
      panel.disabled = !active;
    });
  }

  radios.forEach((radio) => radio.addEventListener('change', () => showPanel(radio.value)));
  showPanel(activePanelType());

  // ---- Reserva estilo Transvip ----
  const bookingPanel = form.querySelector<HTMLFieldSetElement>('[data-panel="booking"]')!;
  const origin = form.querySelector<HTMLInputElement>('#f-origin')!;
  const destination = form.querySelector<HTMLInputElement>('#f-destination')!;
  const summary = document.getElementById('booking-summary')!;

  const formatDate = (value: string) => value.split('-').reverse().join('/');

  // Conjunto de aeropuertos para validar el "modo aeropuerto" del origen/destino
  const COMBINING = new RegExp('[\\u0300-\\u036f]', 'g');
  const norm = (text: string) => text.toLowerCase().normalize('NFD').replace(COMBINING, '').trim();
  const AIRPORT_NAMES = new Set(LOCATIONS.filter((l) => l.type === 'airport').map((l) => norm(l.name)));
  const isAirport = (value: string) => AIRPORT_NAMES.has(norm(value));
  const AIRPORT_PLACEHOLDER = form.dataset.airportPlaceholder ?? '';

  // Guarda el placeholder original para restaurarlo al salir del modo aeropuerto
  origin.dataset.basePlaceholder = origin.placeholder;
  destination.dataset.basePlaceholder = destination.placeholder;

  // En "modo aeropuerto" el campo solo acepta un aeropuerto de la lista
  function refreshAirportValidity(field: HTMLInputElement) {
    const needsAirport = field.dataset.filter === 'airport' && field.value.trim() !== '';
    field.setCustomValidity(needsAirport && !isAirport(field.value) ? (form.dataset.errAirport ?? '') : '');
  }

  // Activa/desactiva el modo aeropuerto sobre un campo (filtra sugerencias a solo aeropuertos)
  function setAirportMode(field: HTMLInputElement, on: boolean) {
    if (on) {
      field.dataset.filter = 'airport';
      field.placeholder = AIRPORT_PLACEHOLDER;
      // Si traía una ciudad (no un aeropuerto), se limpia para que elija uno
      if (field.value.trim() && !isAirport(field.value)) field.value = '';
    } else {
      delete field.dataset.filter;
      field.placeholder = field.dataset.basePlaceholder ?? '';
    }
    refreshAirportValidity(field);
  }

  // El tipo de viaje decide qué campo entra en modo aeropuerto (sin bloquear: se elige entre todos)
  function applyTripType(value: string) {
    setAirportMode(destination, value === 'to-airport');
    setAirportMode(origin, value === 'from-airport');
    updateSummary();
  }

  [origin, destination].forEach((field) =>
    field.addEventListener('input', () => refreshAirportValidity(field)),
  );

  // Muestra/oculta los campos de regreso según solo ida / ida y vuelta
  function applyTripMode(value: string) {
    const round = value === 'round-trip';
    bookingPanel.querySelectorAll<HTMLElement>('[data-return]').forEach((wrapper) => {
      wrapper.hidden = !round;
    });
    ['f-return-date', 'f-return-time'].forEach((id) => {
      const field = document.getElementById(id) as HTMLInputElement;
      field.disabled = !round;
      field.required = round;
    });
    updateSummary();
  }

  form.querySelectorAll<HTMLInputElement>('input[name="trip-type"]').forEach((radio) =>
    radio.addEventListener('change', () => applyTripType(radio.value)),
  );
  form.querySelectorAll<HTMLInputElement>('input[name="trip-mode"]').forEach((radio) =>
    radio.addEventListener('change', () => applyTripMode(radio.value)),
  );

  // Steppers de pasajeros y maletas
  form.querySelectorAll<HTMLButtonElement>('[data-stepper]').forEach((button) => {
    button.addEventListener('click', () => {
      const field = document.getElementById(button.dataset.target!) as HTMLInputElement;
      const next = (Number(field.value) || 0) + Number(button.dataset.stepper);
      field.value = String(Math.min(Number(field.max), Math.max(Number(field.min), next)));
      updateSummary();
    });
  });

  // Si escriben a mano, mantener el número dentro de [min, max] y como entero
  form.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((field) => {
    field.addEventListener('input', () => {
      if (field.value === '') return; // permitir vaciar mientras se edita
      let n = Math.floor(Number(field.value));
      if (Number.isNaN(n)) {
        field.value = '';
        return;
      }
      n = Math.min(Number(field.max), Math.max(Number(field.min), n));
      field.value = String(n);
    });
  });

  // No permitir fechas pasadas; el regreso no puede ser antes de la ida
  const dateField = document.getElementById('f-date') as HTMLInputElement;
  const returnDateField = document.getElementById('f-return-date') as HTMLInputElement;
  dateField.min = new Date().toISOString().slice(0, 10);
  returnDateField.min = dateField.min;
  dateField.addEventListener('change', () => {
    returnDateField.min = dateField.value || dateField.min;
  });

  function updateSummary() {
    const value = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const round = form.querySelector<HTMLInputElement>('input[name="trip-mode"]:checked')?.value === 'round-trip';
    const lines: string[] = [];

    if (value('f-origin') && value('f-destination')) lines.push(`${value('f-origin')} → ${value('f-destination')}`);
    if (value('f-date') || value('f-time'))
      lines.push(`${form.dataset.labelOutbound}: ${formatDate(value('f-date'))} ${value('f-time')}`.trim());
    if (round && (value('f-return-date') || value('f-return-time')))
      lines.push(`${form.dataset.labelReturn}: ${formatDate(value('f-return-date'))} ${value('f-return-time')}`.trim());
    if (lines.length)
      lines.push(`${form.dataset.labelPassengers}: ${value('f-passengers')} · ${form.dataset.labelLuggage}: ${value('f-luggage')}`);

    summary.textContent = lines.length ? lines.join('\n') : (form.dataset.summaryEmpty ?? '');
  }

  // Prellenado desde la mini reserva del inicio (?trip=&origin=&destination=&date=&time=)
  const params = new URLSearchParams(window.location.search);
  // Preselección del tipo de formulario (booking | agreement | jobs) desde la URL,
  // p. ej. /contacto/?form=jobs abre directo "Trabaja con nosotros".
  const formParam = params.get('form');
  if (formParam) {
    const typeRadio = form.querySelector<HTMLInputElement>(`input[name="form-type"][value="${formParam}"]`);
    if (typeRadio) {
      typeRadio.checked = true;
      showPanel(formParam);
    }
  }
  const tripParam = params.get('trip');
  if (tripParam) {
    const tripRadio = form.querySelector<HTMLInputElement>(`input[name="trip-type"][value="${tripParam}"]`);
    if (tripRadio) tripRadio.checked = true;
  }
  (
    [
      ['origin', 'f-origin'],
      ['destination', 'f-destination'],
      ['date', 'f-date'],
      ['time', 'f-time'],
    ] as const
  ).forEach(([key, id]) => {
    const value = params.get(key);
    if (value) (document.getElementById(id) as HTMLInputElement).value = value;
  });
  returnDateField.min = dateField.value || dateField.min;

  bookingPanel.addEventListener('input', updateSummary);
  applyTripType(form.querySelector<HTMLInputElement>('input[name="trip-type"]:checked')?.value ?? 'to-airport');
  applyTripMode(form.querySelector<HTMLInputElement>('input[name="trip-mode"]:checked')?.value ?? 'one-way');

  // ---- Envío a WhatsApp ----
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const type = activePanelType();
    const intro =
      type === 'booking'
        ? form.dataset.introBooking
        : type === 'agreement'
          ? form.dataset.introAgreement
          : form.dataset.introJobs;

    const lines = [`${intro}:`];

    if (type === 'booking') {
      form
        .querySelectorAll<HTMLInputElement>('input[name="trip-type"]:checked, input[name="trip-mode"]:checked')
        .forEach((radio) => lines.push(`• ${radio.dataset.msg}`));
    }

    form
      .querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[data-panel="${type}"] [data-label]`)
      .forEach((field) => {
        if (field.disabled || !field.value.trim()) return;
        let fieldValue =
          field instanceof HTMLInputElement && field.type === 'date' ? formatDate(field.value) : field.value.trim();
        // Teléfono: anteponer el prefijo del país elegido (p. ej. +56 9 1234 5678)
        if (field instanceof HTMLInputElement && field.dataset.phoneInput !== undefined) {
          const country = COUNTRY_CODES.find((c) => c.code === field.dataset.country);
          fieldValue = `${country?.dial ?? ''} ${field.value.trim()}`.trim();
        }
        lines.push(`• ${field.dataset.label}: ${fieldValue}`);
      });

    const url = `https://wa.me/${form.dataset.waNumber}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });

  // ---- Validación con mensajes propios (reemplaza el globo nativo del navegador) ----
  const REQUIRED_MSG = form.dataset.errRequired ?? 'Completa este campo';

  type FieldEl = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  // El mensaje de error se ancla bajo el grupo (data-error-anchor) o, si no hay, junto al campo
  const errorAnchor = (field: FieldEl) =>
    (field.closest('[data-error-anchor]') as HTMLElement | null) ?? field.parentElement;

  const showFieldError = (field: FieldEl, message: string) => {
    field.classList.add('is-invalid');
    field.setAttribute('aria-invalid', 'true');
    const wrapper = errorAnchor(field);
    if (!wrapper) return;
    let msg = wrapper.querySelector<HTMLElement>('[data-error]');
    if (!msg) {
      msg = document.createElement('p');
      msg.setAttribute('data-error', '');
      msg.className = 'mt-1.5 text-xs font-semibold text-red-600';
      wrapper.appendChild(msg);
    }
    msg.textContent = message;
  };

  const clearFieldError = (field: FieldEl) => {
    field.classList.remove('is-invalid');
    field.removeAttribute('aria-invalid');
    errorAnchor(field)?.querySelector('[data-error]')?.remove();
  };

  // Nombre: empieza con letra y solo letras/tildes/ñ, espacios, guion y apóstrofe (2–60)
  const NAME_RE = /^[\p{L}\p{M}][\p{L}\p{M} '’.\-]{1,59}$/u;

  function phoneError(field: HTMLInputElement): string {
    if (field.value.trim() === '') return '';
    const country = COUNTRY_CODES.find((c) => c.code === field.dataset.country);
    const digits = field.value.replace(/\D/g, '');
    if (country?.len) {
      const ok = digits.length === country.len && (!country.startsWith || digits.startsWith(country.startsWith));
      return ok ? '' : (form.dataset.errPhoneCl ?? form.dataset.errPhone ?? '');
    }
    return digits.length >= 8 && digits.length <= 15 ? '' : (form.dataset.errPhone ?? '');
  }

  // Calcula y fija la validez según el tipo de campo (deja que el navegador bloquee el envío)
  function applyValidator(field: FieldEl) {
    const type = field.dataset.validate;
    if (type === 'name') {
      const v = field.value.trim();
      field.setCustomValidity(v === '' || NAME_RE.test(v) ? '' : (form.dataset.errName ?? ''));
    } else if (type === 'phone') {
      field.setCustomValidity(phoneError(field as HTMLInputElement));
    }
  }

  function messageFor(field: FieldEl): string {
    const v = field.validity;
    if (v.valueMissing) return REQUIRED_MSG;
    if (v.customError) return field.validationMessage; // nombre / teléfono / aeropuerto
    if (v.rangeOverflow || v.rangeUnderflow || v.badInput || v.stepMismatch) {
      if (field.dataset.validate === 'passengers') return form.dataset.errPassengers ?? field.validationMessage;
      if (field.dataset.validate === 'luggage') return form.dataset.errLuggage ?? field.validationMessage;
    }
    return field.validationMessage;
  }

  form.querySelectorAll<FieldEl>('input, textarea, select').forEach((field) => {
    field.addEventListener('invalid', (event) => {
      event.preventDefault(); // ocultar el globo nativo del navegador
      showFieldError(field, messageFor(field));
    });
    field.addEventListener('input', () => {
      clearFieldError(field);
      applyValidator(field);
    });
    field.addEventListener('change', () => {
      clearFieldError(field);
      applyValidator(field);
    });
    // Al salir del campo, mostrar errores de formato (no de obligatoriedad)
    field.addEventListener('blur', () => {
      if (field.value.trim() !== '' && (field.dataset.validate || field.dataset.filter)) field.checkValidity();
    });
  });

  // ---- Selector de país del teléfono (bandera + prefijo) ----
  form.querySelectorAll<HTMLElement>('[data-phone-field]').forEach((wrap) => {
    const trigger = wrap.querySelector<HTMLButtonElement>('[data-country-trigger]')!;
    const list = wrap.querySelector<HTMLUListElement>('[data-country-list]')!;
    const input = wrap.querySelector<HTMLInputElement>('[data-phone-input]')!;
    const flagEl = wrap.querySelector<HTMLElement>('[data-country-flag]')!;
    const dialEl = wrap.querySelector<HTMLElement>('[data-country-dial]')!;
    const options = Array.from(list.querySelectorAll<HTMLLIElement>('[data-code]'));
    let active = -1;

    const paint = () => options.forEach((o, i) => o.classList.toggle('bg-mist', i === active));
    const open = () => {
      list.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      active = options.findIndex((o) => o.dataset.code === input.dataset.country);
      paint();
      options[active]?.scrollIntoView({ block: 'nearest' });
    };
    const close = () => {
      list.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      active = -1;
    };
    const choose = (code: string) => {
      const c = COUNTRY_CODES.find((x) => x.code === code);
      if (!c) return;
      input.dataset.country = c.code;
      flagEl.textContent = c.flag;
      dialEl.textContent = c.dial;
      input.placeholder = c.example;
      clearFieldError(input);
      applyValidator(input);
      close();
      input.focus();
    };

    trigger.addEventListener('click', () => (list.hidden ? open() : close()));
    options.forEach((o) => o.addEventListener('click', () => choose(o.dataset.code!)));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (list.hidden) return open();
        active = (active + 1) % options.length;
        paint();
        options[active].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (list.hidden) return;
        active = (active - 1 + options.length) % options.length;
        paint();
        options[active].scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter' && !list.hidden && active >= 0) {
        event.preventDefault();
        choose(options[active].dataset.code!);
      } else if (event.key === 'Escape') {
        close();
      }
    });
    // Mantener solo dígitos y separadores en el número
    input.addEventListener('input', () => {
      const cleaned = input.value.replace(/[^\d\s()+.-]/g, '');
      if (cleaned !== input.value) input.value = cleaned;
    });
    document.addEventListener('click', (event) => {
      if (!wrap.contains(event.target as Node)) close();
    });
  });

  // ---- Abrir el calendario/reloj al hacer clic en todo el campo ----
  form.querySelectorAll<HTMLInputElement>('input[type="date"], input[type="time"]').forEach((field) => {
    field.addEventListener('click', () => {
      try {
        (field as HTMLInputElement & { showPicker?: () => void }).showPicker?.();
      } catch {
        /* algunos navegadores requieren un gesto del usuario; el clic lo es */
      }
    });
  });
</script>

<script>
  // Autocompletado de ubicaciones en origen/destino.
  // Fuente de sugerencias:
  //   • Con PUBLIC_GOOGLE_MAPS_API_KEY definida → Google Places API (New): cualquier
  //     dirección o lugar de Chile (incluye calle y número).
  //   • Sin la variable (por defecto) → dataset local sin costo (src/data/locations.ts).
  // Queda "listo pero apagado": activar = definir la variable (p. ej. en Vercel) con
  // una API key que tenga habilitada "Places API (New)" y restringida por dominio.
  import { LOCATIONS } from '../data/locations';

  type Suggestion = { name: string; region: string; type: 'airport' | 'city'; value?: string };

  const MAPS_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY as string | undefined;

  const ICONS = {
    airport:
      '<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 stroke-action-bright" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>',
    city: '<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 stroke-primary/60" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>',
  };

  const COMBINING_MARKS = new RegExp('[\\u0300-\\u036f]', 'g');
  const normalize = (text: string) =>
    text
      .toLowerCase()
      .normalize('NFD')
      .replace(COMBINING_MARKS, '');

  // Fuente local (gratis, por defecto). Con filter='airport' solo sugiere aeropuertos.
  const searchLocal = (raw: string, filter?: string): Suggestion[] => {
    const pool = filter === 'airport' ? LOCATIONS.filter((l) => l.type === 'airport') : LOCATIONS;
    const cap = filter === 'airport' ? 14 : 8;
    const query = normalize(raw.trim());
    if (filter === 'airport' && query.length === 0) return pool.slice(0, cap); // al enfocar: todos
    if (query.length < 2) return [];
    const starts = pool.filter((location) => normalize(location.name).startsWith(query));
    const contains = pool.filter(
      (location) =>
        !starts.includes(location) &&
        (normalize(location.name).includes(query) || normalize(location.region).includes(query)),
    );
    return [...starts, ...contains].slice(0, cap);
  };

  // Fuente Google Places API (New) — solo se usa si hay API key
  const searchGoogle = async (raw: string, filter?: string): Promise<Suggestion[]> => {
    if (raw.trim().length < 2) return [];
    try {
      const res = await fetch('https://places.googleapis.com/v1/places:autocomplete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Goog-Api-Key': MAPS_KEY as string },
        body: JSON.stringify({
          input: raw,
          includedRegionCodes: ['cl'],
          languageCode: document.documentElement.lang || 'es',
          ...(filter === 'airport' ? { includedPrimaryTypes: ['airport'] } : {}),
        }),
      });
      if (!res.ok) return [];
      const data = await res.json();
      return (data.suggestions ?? [])
        .map((s: any): Suggestion | null => {
          const p = s.placePrediction;
          if (!p) return null;
          return {
            name: p.structuredFormat?.mainText?.text ?? p.text?.text ?? '',
            region: p.structuredFormat?.secondaryText?.text ?? '',
            type: 'city',
            value: p.text?.text ?? '',
          };
        })
        .filter((x: Suggestion | null): x is Suggestion => !!x && x.name.length > 0)
        .slice(0, 8);
    } catch {
      return [];
    }
  };

  const search = MAPS_KEY ? searchGoogle : searchLocal;

  document.querySelectorAll<HTMLInputElement>('input[data-autocomplete]').forEach((input) => {
    const wrapper = input.parentElement as HTMLElement;
    const list = document.createElement('ul');
    list.className =
      'absolute left-0 right-0 top-full z-30 mt-1.5 hidden max-h-72 overflow-auto rounded-2xl border border-primary/10 bg-white py-1.5 shadow-xl shadow-primary/15';
    list.setAttribute('role', 'listbox');
    wrapper.appendChild(list);

    let matches: Suggestion[] = [];
    let active = -1;
    let requestId = 0;
    let debounce: number | undefined;
    let suppress = false; // evita que el input programático tras seleccionar reabra la lista

    const close = () => {
      list.classList.add('hidden');
      list.innerHTML = '';
      matches = [];
      active = -1;
    };

    const select = (index: number) => {
      const location = matches[index];
      if (!location) return;
      input.value = location.value ?? location.name;
      // Notificar a los demás listeners (resumen, validez de aeropuerto, limpiar error)
      // sin reabrir esta misma lista de autocompletado.
      suppress = true;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      suppress = false;
      close();
    };

    const paintActive = () => {
      list.querySelectorAll('li').forEach((item, i) => {
        item.classList.toggle('bg-mist', i === active);
        if (i === active) item.scrollIntoView({ block: 'nearest' });
      });
    };

    const render = () => {
      if (!matches.length) return close();
      list.innerHTML = '';
      matches.forEach((location, index) => {
        const item = document.createElement('li');
        item.setAttribute('role', 'option');
        item.className = 'flex cursor-pointer items-center gap-3 px-4 py-2.5 hover:bg-mist';
        item.innerHTML = `${ICONS[location.type]}<span class="min-w-0"><span class="block truncate text-sm font-semibold text-ink">${location.name}</span><span class="block truncate text-xs text-ink/70">${location.region}</span></span>`;
        // mousedown (no click) para seleccionar antes de que el blur cierre la lista
        item.addEventListener('mousedown', (event) => {
          event.preventDefault();
          select(index);
        });
        list.appendChild(item);
      });
      list.classList.remove('hidden');
    };

    const runSearch = () => {
      const id = ++requestId;
      Promise.resolve(search(input.value, input.dataset.filter)).then((results) => {
        if (id !== requestId) return; // descartar respuestas que llegaron tarde
        matches = results;
        active = -1;
        render();
      });
    };

    input.addEventListener('input', () => {
      if (suppress) return; // ignorar el input programático tras seleccionar
      const airportMode = input.dataset.filter === 'airport';
      // En modo aeropuerto se sugiere incluso con el campo casi vacío (lista completa)
      if (!airportMode && input.value.trim().length < 2) return close();
      window.clearTimeout(debounce);
      // sin key: instantáneo; con key (consulta de red): pequeño debounce
      debounce = window.setTimeout(runSearch, MAPS_KEY ? 200 : 0);
    });

    // Al enfocar en modo aeropuerto, mostrar de inmediato todos los aeropuertos
    input.addEventListener('focus', () => {
      if (input.dataset.filter === 'airport') runSearch();
    });

    input.addEventListener('keydown', (event) => {
      if (!matches.length) return;
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        active = (active + 1) % matches.length;
        paintActive();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        active = (active - 1 + matches.length) % matches.length;
        paintActive();
      } else if (event.key === 'Enter' && active >= 0) {
        event.preventDefault();
        select(active);
      } else if (event.key === 'Escape') {
        close();
      }
    });

    input.addEventListener('blur', () => close());
  });
</script>
