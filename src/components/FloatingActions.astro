---
/**
 * Botones de acción flotantes (esquina inferior derecha), apilados:
 * Instagram arriba (degradado de marca) y WhatsApp abajo, pegado a la esquina.
 * Un único contenedor flex-col evita solapamientos y mantiene el gap parejo.
 */
import { getLangFromUrl, useTranslations } from '../i18n';
import { waLink, INSTAGRAM_URL } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="fixed right-4 bottom-4 z-50 flex flex-col gap-3 md:right-6 md:bottom-6">
  <a
    href={INSTAGRAM_URL}
    target="_blank"
    rel="noopener"
    aria-label={t('common.instagramCta')}
    class="flex h-14 w-14 items-center justify-center rounded-full text-white shadow-lg shadow-black/25 transition-transform hover:scale-110"
    style="background:linear-gradient(45deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5)"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-7 w-7 stroke-current"
      fill="none"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.5 6.5h.01" />
    </svg>
  </a>

  <a
    href={waLink()}
    target="_blank"
    rel="noopener"
    aria-label={t('common.whatsappCta')}
    class="flex h-14 w-14 items-center justify-center rounded-full bg-wa text-white shadow-lg shadow-wa/40 transition-transform hover:scale-110"
  >
    <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current" aria-hidden="true">
      <path d="M12 2a9.9 9.9 0 0 0-8.5 15.1L2 22l5-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1a17 17 0 0 1-1.7-.6c-3-1.3-5-4.4-5.1-4.6-.1-.2-1.2-1.6-1.2-3.1 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l1 2.3c0 .2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.1.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.2.5.1.7-.1l.9-1c.2-.3.4-.3.7-.2l2.2 1c.3.2.5.3.6.4.1.2.1.7-.2 1.2Z" />
    </svg>
  </a>
</div>
