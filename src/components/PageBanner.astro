---
/**
 * Banner de cabecera para páginas interiores.
 * Imagen de fondo a pantalla completa con el mismo estilo de gradiente
 * que el hero de la portada (más transparente que el antiguo bg-primary sólido).
 * Acepta slot para el contenido (título, eyebrow, texto, badges, etc.).
 */
interface Props {
  image: string;
  /** CSS object-position value, ej: "center 40%" o "center top" */
  imagePosition?: string;
}
const { image, imagePosition = 'center' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink">
  <img
    src={image}
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
    style={`object-position: ${imagePosition}`}
  />
  <!-- Mismo esquema de gradiente que el hero de portada, algo más ligero -->
  <div class="absolute inset-0 bg-gradient-to-r from-ink/80 via-primary/50 to-primary/15" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-ink/20" aria-hidden="true"></div>

  <div class="relative">
    <slot />
  </div>
</section>
