---
import raw from '../assets/chile.svg?raw';
import { getLangFromUrl, useTranslations } from '../i18n';
import { regionPhotos } from '../data/regionPhotos';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const regions = t<string[]>('regions');
const regionPlaces = t<string[][]>('regionPlaces');

const REGION_IDS = [
  'CL-AP', // Arica y Parinacota
  'CL-TA', // Tarapacá
  'CL-AN', // Antofagasta
  'CL-AT', // Atacama
  'CL-CO', // Coquimbo
  'CL-VS', // Valparaíso
  'CL-RM', // Metropolitana de Santiago
  'CL-LI', // O'Higgins
  'CL-ML', // Maule
  'CL-NU', // Ñuble
  'CL-BI', // Biobío
  'CL-AR', // La Araucanía
  'CL-LR', // Los Ríos
  'CL-LL', // Los Lagos
  'CL-AI', // Aysén
  'CL-MA', // Magallanes
];

const pathsById = new Map<string, string>();
for (const tag of raw.match(/<path\b[^>]*>/g) ?? []) {
  const id = tag.match(/\bid="(CL-[A-Z]{2})"/)?.[1];
  const d = tag.match(/\bd="([^"]+)"/)?.[1];
  if (id && d) pathsById.set(id, d);
}

const segments = REGION_IDS.map((id, i) => ({ name: regions[i], d: pathsById.get(id) ?? '' }));

// Continental Chile only — crop out Pacific islands
const VIEWBOX = '476 -3 140 715';
---

<div class="space-y-6">
  <div id="coverage-map" class="grid items-center gap-10 lg:grid-cols-[minmax(0,300px)_1fr]">
    <figure class="relative mx-auto w-fit">
      <svg viewBox={VIEWBOX} class="h-[420px] w-auto md:h-[500px]" role="img" aria-label={t('about.coverageMapLabel')}>
        {
          segments.map((segment, i) => (
            <path d={segment.d} data-region={i} tabindex="-1">
              <title>{segment.name}</title>
            </path>
          ))
        }
      </svg>
    </figure>

    <ol class="grid gap-2.5 sm:grid-cols-2">
      {
        regions.map((region, i) => (
          <li class="reveal">
            <button
              type="button"
              data-region={i}
              class="flex w-full items-center gap-3 rounded-2xl bg-white/5 px-4 py-3 text-left transition-colors hover:bg-white/10"
            >
              <span class="num flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/20 font-display text-xs font-bold text-accent transition-colors">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="region-name text-sm font-semibold text-white/90">{region}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Tourist places panel: hidden until a region is selected -->
  <div id="places-panel" class="hidden scroll-mt-28 overflow-hidden rounded-3xl bg-white/5" aria-live="polite" aria-atomic="true">
    <div id="places-photos" class="hidden grid grid-cols-3 gap-px h-52 md:h-64">
      <div class="photo-wrap"><span class="spinner" aria-hidden="true"></span><img alt="" loading="lazy" decoding="async" /></div>
      <div class="photo-wrap"><span class="spinner" aria-hidden="true"></span><img alt="" loading="lazy" decoding="async" /></div>
      <div class="photo-wrap"><span class="spinner" aria-hidden="true"></span><img alt="" loading="lazy" decoding="async" /></div>
    </div>
    <div class="p-6">
      <p class="text-xs font-bold uppercase tracking-widest text-sun/70">{t('coverage.placesTitle')}</p>
      <h3 id="places-title" class="mt-1 font-display text-xl font-extrabold text-white"></h3>
      <ul id="places-list" class="mt-4 flex list-none flex-wrap gap-2 p-0 m-0"></ul>
    </div>
  </div>

  <p id="places-hint" class="text-center text-sm text-white/40">{t('coverage.placesHint')}</p>
</div>

<!-- Lightbox modal -->
<div id="photo-lightbox" role="dialog" aria-modal="true" aria-label="Imagen ampliada">
  <button id="lightbox-close" aria-label="Cerrar">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <img id="lightbox-img" alt="" />
  <p id="lightbox-caption"></p>
</div>

<!-- Data containers: <div hidden> + set:text guarantees textContent works in all browsers -->
<div id="places-data" hidden set:text={JSON.stringify(regionPlaces)}></div>
<div id="photos-data" hidden set:text={JSON.stringify(regionPhotos)}></div>

<style>
  figure svg path {
    stroke: var(--color-ink);
    stroke-width: 0.6;
  }
  path[data-region] {
    fill: rgb(59 182 245 / 0.3);
    cursor: pointer;
    transition: fill 0.2s ease;
    outline: none;
  }
  path[data-region]:nth-of-type(even) {
    fill: rgb(30 132 229 / 0.55);
  }
  path[data-region]:hover,
  path[data-region].is-lit {
    fill: var(--color-sun);
  }
  button[data-region].is-lit {
    background: rgb(255 255 255 / 0.14);
  }
  button[data-region].is-lit .num {
    background: var(--color-sun);
    color: var(--color-ink);
  }

  /* ── Place pill interactions ────────────────────── */
  .place-pill {
    cursor: pointer;
    border: none;
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  @media (hover: hover) {
    .place-pill:hover {
      transform: translateY(-4px) scale(1.06);
      background-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
      box-shadow:
        0 8px 24px -6px color-mix(in srgb, var(--color-accent) 50%, transparent),
        0 0 0 1px color-mix(in srgb, var(--color-accent) 30%, transparent);
    }

    .place-pill:hover .pill-icon {
      animation: pin-bounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
  }

  .place-pill:active {
    transform: scale(0.94);
    transition-duration: 0.1s;
  }

  .place-pill:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .pill-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  @keyframes pin-bounce {
    0%   { transform: translateY(0)   scale(1);    }
    35%  { transform: translateY(-6px) scale(1.25); }
    65%  { transform: translateY(-2px) scale(0.9);  }
    85%  { transform: translateY(-1px) scale(1.05); }
    100% { transform: translateY(0)   scale(1);    }
  }

  /* ── Photo grid hover effect ─────────────────────── */
  .photo-wrap {
    overflow: hidden;
    position: relative;
    cursor: zoom-in;
    background: rgba(255, 255, 255, 0.04);
  }

  .photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    transform: scale(1);
    transition:
      transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      filter 0.45s ease,
      opacity 0.45s ease;
    will-change: transform, opacity;
  }

  .photo-wrap.is-loading img {
    opacity: 0;
    transform: scale(1.04);
  }

  .photo-wrap .spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border: 3px solid rgba(255, 255, 255, 0.18);
    border-top-color: var(--color-sun);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    transition: opacity 0.25s ease;
    animation: spinner-rotate 0.8s linear infinite;
  }

  .photo-wrap.is-loading .spinner {
    opacity: 1;
  }

  @keyframes spinner-rotate {
    to { transform: rotate(360deg); }
  }

  /* shine overlay */
  .photo-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      130deg,
      rgba(255, 255, 255, 0.22) 0%,
      rgba(255, 255, 255, 0.06) 45%,
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  @media (hover: hover) {
    .photo-wrap:hover img,
    .photo-wrap.is-lit-pill img {
      transform: scale(1.09);
      filter: brightness(1.18) saturate(1.1);
    }
    .photo-wrap:hover::after,
    .photo-wrap.is-lit-pill::after {
      opacity: 1;
    }
  }

  /* ── Lightbox ────────────────────────────────────── */
  #photo-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  #photo-lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  #lightbox-img {
    max-width: min(92vw, 940px);
    max-height: 78vh;
    object-fit: contain;
    border-radius: 0.75rem;
    box-shadow: 0 32px 72px rgba(0, 0, 0, 0.55);
    transform: scale(0.82);
    opacity: 0;
    transition:
      transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.3s ease;
  }

  #photo-lightbox.is-open #lightbox-img {
    transform: scale(1);
    opacity: 1;
  }

  #lightbox-caption {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.875rem;
    text-align: center;
    max-width: 560px;
    transform: translateY(8px);
    opacity: 0;
    transition: opacity 0.3s ease 0.2s, transform 0.3s ease 0.2s;
  }

  #photo-lightbox.is-open #lightbox-caption {
    opacity: 1;
    transform: translateY(0);
  }

  #lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: white;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    backdrop-filter: blur(4px);
  }

  #lightbox-close:hover {
    background: rgba(255, 255, 255, 0.22);
    transform: scale(1.12);
  }
</style>

<script>
  const root = document.getElementById('coverage-map');
  if (root) {
    const paths = [...root.querySelectorAll<SVGPathElement>('path[data-region]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-region]')];
    let selected = -1;

    const panel = document.getElementById('places-panel') as HTMLElement | null;
    const placesTitle = document.getElementById('places-title') as HTMLElement | null;
    const placesList = document.getElementById('places-list') as HTMLElement | null;
    const photosContainer = document.getElementById('places-photos') as HTMLElement | null;
    const photoImgs = photosContainer
      ? [...photosContainer.querySelectorAll<HTMLImageElement>('img')]
      : [];
    const hint = document.getElementById('places-hint') as HTMLElement | null;

    const placesData = JSON.parse(
      document.getElementById('places-data')?.textContent?.trim() ?? '[]'
    ) as string[][];

    const photosData = JSON.parse(
      document.getElementById('photos-data')?.textContent?.trim() ?? '[]'
    ) as string[][];

    const paint = (index: number, lit: boolean) => {
      paths[index]?.classList.toggle('is-lit', lit || index === selected);
      buttons[index]?.classList.toggle('is-lit', lit || index === selected);
    };

    const showPlaces = (index: number) => {
      if (!panel || !placesTitle || !placesList) return;
      panel.classList.remove('hidden');
      hint?.classList.add('hidden');

      const regionName =
        buttons[index]?.querySelector<HTMLElement>('.region-name')?.textContent ?? '';
      placesTitle.textContent = regionName;

      const places = placesData[index] ?? [];
      const regionPhotosArr = photosData[index] ?? [];

      if (photosContainer && photoImgs.length > 0) {
        photoImgs.forEach((img, j) => {
          const wrap = img.parentElement;
          const newSrc = regionPhotosArr[j] ?? '';
          img.alt = places[j] ?? regionName;

          wrap?.classList.add('is-loading');

          if (!newSrc) {
            img.removeAttribute('src');
            wrap?.classList.remove('is-loading');
            return;
          }

          const reveal = () => {
            setTimeout(() => wrap?.classList.remove('is-loading'), 120 + j * 140);
          };

          const onDone = () => {
            img.removeEventListener('load', onDone);
            img.removeEventListener('error', onDone);
            reveal();
          };

          img.addEventListener('load', onDone);
          img.addEventListener('error', onDone);
          img.src = newSrc;

          if (img.complete && img.naturalWidth > 0) onDone();
        });
        photosContainer.classList.remove('hidden');
      }

      placesList.innerHTML = places
        .map(
          (place, j) =>
            `<li><button type="button" data-idx="${j}" class="place-pill inline-flex items-center gap-1.5 rounded-full bg-accent/20 px-3 py-1.5 text-sm font-semibold text-accent">` +
            `<svg viewBox="0 0 24 24" class="pill-icon h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">` +
            `<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>` +
            `${place}</button></li>`
        )
        .join('');

      placesList.querySelectorAll<HTMLButtonElement>('.place-pill').forEach((btn) => {
        const j = Number(btn.dataset.idx);
        const photoWrap = photoImgs[j]?.parentElement;

        btn.addEventListener('mouseenter', () => photoWrap?.classList.add('is-lit-pill'));
        btn.addEventListener('mouseleave', () => photoWrap?.classList.remove('is-lit-pill'));
        btn.addEventListener('click', () => {
          const src = regionPhotosArr[j];
          if (src) openLightbox(src, places[j] ?? '');
        });
      });

      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const hidePlaces = () => {
      panel?.classList.add('hidden');
      hint?.classList.remove('hidden');
    };

    const select = (index: number) => {
      const previous = selected;
      selected = selected === index ? -1 : index;
      if (previous >= 0) paint(previous, false);
      if (selected >= 0) {
        paint(selected, true);
        showPlaces(selected);
      } else {
        hidePlaces();
      }
    };

    buttons.forEach((button, i) => {
      button.addEventListener('mouseenter', () => paint(i, true));
      button.addEventListener('mouseleave', () => paint(i, false));
      button.addEventListener('focus', () => paint(i, true));
      button.addEventListener('blur', () => paint(i, false));
      button.addEventListener('click', () => select(i));
    });

    paths.forEach((path, i) => {
      path.addEventListener('mouseenter', () => paint(i, true));
      path.addEventListener('mouseleave', () => paint(i, false));
      path.addEventListener('click', () => select(i));
    });

    // ── Lightbox ──────────────────────────────────────
    const lightbox = document.getElementById('photo-lightbox') as HTMLElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption') as HTMLElement | null;
    const lightboxClose = document.getElementById('lightbox-close') as HTMLButtonElement | null;

    const openLightbox = (src: string, caption: string) => {
      if (!lightbox || !lightboxImg || !lightboxCaption) return;
      lightboxImg.src = src;
      lightboxImg.alt = caption;
      lightboxCaption.textContent = caption;
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      lightboxClose?.focus();
    };

    const closeLightbox = () => {
      lightbox?.classList.remove('is-open');
      document.body.style.overflow = '';
    };

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('is-open')) closeLightbox();
    });

    photoImgs.forEach((img) => {
      img.addEventListener('click', () => {
        if (img.src) openLightbox(img.src, img.alt);
      });
    });
  }
</script>
