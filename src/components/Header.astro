---
import { getLangFromUrl, useTranslations, localePath, switchLangPath, languages, type Lang } from '../i18n';
import { waLink } from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { route: 'about', label: t('nav.about') },
  { route: 'services', label: t('nav.services') },
  { route: 'agreement', label: t('nav.agreement') },
  { route: 'fleet', label: t('nav.fleet') },
  { route: 'contact', label: t('nav.contact') },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href;
---

<header class="sticky top-0 z-40 border-b border-primary/10 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 md:h-20 md:px-6">
    <a href={localePath(lang, 'home')} class="flex shrink-0 items-center" aria-label="WinTransfer — {t('nav.home')}">
      <!-- [PENDIENTE: logo oficial en alta calidad — se usa versión recortada del PNG actual] -->
      <img src="/logo.png" alt="WinTransfer" class="h-10 w-auto md:h-12" width="604" height="332" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="principal">
      {
        navItems.map((item) => {
          const href = localePath(lang, item.route);
          return (
            <a
              href={href}
              class:list={[
                'rounded-full px-3.5 py-2 text-sm font-semibold transition-colors',
                isActive(href) ? 'bg-mist text-primary' : 'text-ink/80 hover:bg-mist hover:text-primary',
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <div class="flex items-center overflow-hidden rounded-full border border-primary/20 text-xs font-bold" aria-label="Idioma / Language">
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <a
              href={switchLangPath(Astro.url, code)}
              class:list={[
                'px-2.5 py-1.5 transition-colors',
                code === lang ? 'bg-primary text-white' : 'text-primary hover:bg-mist',
              ]}
              aria-current={code === lang ? 'true' : undefined}
            >
              {languages[code]}
            </a>
          ))
        }
      </div>

      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-full bg-wa px-4 py-2 text-sm font-bold text-white transition-transform hover:scale-105 sm:inline-flex"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M12 2a9.9 9.9 0 0 0-8.5 15.1L2 22l5-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1a17 17 0 0 1-1.7-.6c-3-1.3-5-4.4-5.1-4.6-.1-.2-1.2-1.6-1.2-3.1 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l1 2.3c0 .2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.1.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.2.5.1.7-.1l.9-1c.2-.3.4-.3.7-.2l2.2 1c.3.2.5.3.6.4.1.2.1.7-.2 1.2Z"/></svg>
        WhatsApp
      </a>

      <button
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-primary hover:bg-mist lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menú"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6 stroke-current" fill="none" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-primary/10 bg-white px-4 pt-2 pb-4 lg:hidden" aria-label="principal móvil">
    {
      navItems.map((item) => {
        const href = localePath(lang, item.route);
        return (
          <a
            href={href}
            class:list={[
              'block rounded-xl px-4 py-3 font-semibold',
              isActive(href) ? 'bg-mist text-primary' : 'text-ink/80 hover:bg-mist hover:text-primary',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
    <a
      href={waLink()}
      target="_blank"
      rel="noopener"
      class="mt-2 flex items-center justify-center gap-2 rounded-xl bg-wa px-4 py-3 font-bold text-white"
    >
      WhatsApp
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
