---
import { getLangFromUrl, useTranslations, localePath } from '../i18n';
import {
  waLink,
  CONTACT_EMAIL,
  CONTACT_PHONE_DISPLAY,
  CONTACT_PHONE_2_DISPLAY,
  WHATSAPP_NUMBER_2,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
} from '../config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const regions = t<string[]>('regions');
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 md:px-6 lg:grid-cols-4">
    <div>
      <img src="/logo.png" alt="WinTransfer" class="h-12 w-auto rounded bg-white/95 p-1.5" width="604" height="332" />
      <p class="mt-4 max-w-xs text-sm text-white/70">“{t('site.slogan')}”</p>
      <p class="mt-3 text-xs text-sun">{t('footer.sernatur')}</p>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold tracking-wider text-accent uppercase">{t('footer.contactTitle')}</h3>
      <ul class="mt-4 space-y-2 text-sm text-white/80">
        <li>
          <a href={waLink()} target="_blank" rel="noopener" class="hover:text-accent">{CONTACT_PHONE_DISPLAY}</a>
        </li>
        <li>
          <a href={`https://wa.me/${WHATSAPP_NUMBER_2}`} target="_blank" rel="noopener" class="hover:text-accent">{CONTACT_PHONE_2_DISPLAY}</a>
        </li>
        <li>
          <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-accent">{CONTACT_EMAIL}</a>
        </li>
        <li>{t('contact.hoursValue')}</li>
      </ul>
      <h3 class="mt-6 font-display text-sm font-bold tracking-wider text-accent uppercase">{t('footer.socialTitle')}</h3>
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener"
        class="mt-2 inline-flex items-center gap-2 text-sm text-white/80 hover:text-accent"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>
        {INSTAGRAM_HANDLE}
      </a>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold tracking-wider text-accent uppercase">{t('footer.coverageTitle')}</h3>
      <p class="mt-4 text-sm text-white/80">{t('footer.coverageText')}</p>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {regions.map((region) => <li class="rounded-full bg-white/10 px-2.5 py-1 text-[11px] text-white/70">{region}</li>)}
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-bold tracking-wider text-accent uppercase">{t('footer.paymentTitle')}</h3>
      <p class="mt-4 text-sm text-white/80">{t('footer.paymentText')}</p>
      <a
        href={localePath(lang, 'contact')}
        class="mt-6 inline-block rounded-full bg-action-bright px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-accent hover:text-ink"
      >
        {t('common.bookNow')}
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-5 text-xs text-white/50 sm:flex-row md:px-6">
      <p>© {year} WinTransfer. {t('footer.rights')}</p>
      <a href={localePath(lang, 'terms')} class="hover:text-accent">{t('footer.termsLink')}</a>
    </div>
  </div>
</footer>
