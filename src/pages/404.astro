---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';
import { waLink } from '../config';

// La 404 se prerenderiza a un único 404.html, así que no conoce el idioma en
// el servidor. Renderizamos ES (locale por defecto) e intercambiamos a EN/PT en
// el cliente según la URL. Todo el texto sale de los JSON, nunca hardcode.
const es = useTranslations('es');
const en = useTranslations('en');
const pt = useTranslations('pt');

const copy = {
  es: {
    title: es('notFound.title'),
    text: es('notFound.text'),
    home: es('notFound.home'),
    whatsapp: es('notFound.whatsapp'),
    homeHref: '/es/',
  },
  en: {
    title: en('notFound.title'),
    text: en('notFound.text'),
    home: en('notFound.home'),
    whatsapp: en('notFound.whatsapp'),
    homeHref: '/en/',
  },
  pt: {
    title: pt('notFound.title'),
    text: pt('notFound.text'),
    home: pt('notFound.home'),
    whatsapp: pt('notFound.whatsapp'),
    homeHref: '/pt/',
  },
};

const wa = waLink();
---

<BaseLayout title={copy.es.title}>
  <section class="flex min-h-[68vh] items-center justify-center bg-primary px-4 py-20">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-display text-7xl font-extrabold leading-none text-sun md:text-8xl">404</p>
      <h1 id="nf-title" class="mt-4 font-display text-3xl font-extrabold text-white md:text-4xl">
        {copy.es.title}
      </h1>
      <p id="nf-text" class="mt-3 text-base text-white/70">{copy.es.text}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          id="nf-home"
          href={copy.es.homeHref}
          class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-primary transition-colors hover:bg-mist"
        >
          {copy.es.home}
        </a>
        <a
          id="nf-wa"
          href={wa}
          target="_blank"
          rel="noopener"
          class="rounded-full bg-wa px-6 py-3 text-sm font-semibold text-white transition-colors hover:brightness-110"
        >
          {copy.es.whatsapp}
        </a>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ copy }}>
    const seg = location.pathname.split('/')[1];
    if (seg === 'en' || seg === 'pt') {
      const c = copy[seg];
      document.documentElement.lang = seg;
      document.getElementById('nf-title').textContent = c.title;
      document.getElementById('nf-text').textContent = c.text;
      const home = document.getElementById('nf-home');
      home.textContent = c.home;
      home.setAttribute('href', c.homeHref);
      document.getElementById('nf-wa').textContent = c.whatsapp;
    }
  </script>
</BaseLayout>
