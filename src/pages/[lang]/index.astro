---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSlideshow from '../../components/HeroSlideshow.astro';
import MiniBookingForm from '../../components/MiniBookingForm.astro';
import ExperiencePanels from '../../components/ExperiencePanels.astro';
import { serviceImages } from '../../data/serviceImages';
import { partnerLogos } from '../../data/partnerLogos';
import { useTranslations, localePath, type Lang } from '../../i18n';
import { waLink } from '../../config';

// Fotos de fondo del hero (slideshow con fundido limpio). Optimizadas en public/images.
const heroImages = [
  '/images/servicio-personal.webp',
  '/images/icecar.webp',
  '/images/hero-nieve.webp',
];

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }, { params: { lang: 'pt' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

interface ServiceItem {
  id: string;
  title: string;
  text: string;
  mediaLabel: string;
}
interface TrustItem {
  title: string;
  text: string;
}

const services = t<ServiceItem[]>('services.items');
const trust = t<TrustItem[]>('home.trust');
// Repetimos las tarjetas 4× para el carrusel infinito: así el "camino" llena
// pantallas anchas sin huecos y el loop (mueve una tanda por vuelta) no corta.
const trustLoop = [...trust, ...trust, ...trust, ...trust];
const partners = t<string[]>('partners');
const rotating = t<string[]>('home.heroRotating');

// Separamos la última palabra del slogan ("ganar" en ES / "winning" en EN)
// para destacarla en amarillo y rotarle la tipografía. El resto del título
// queda igual, en el idioma de la página.
const sloganWords = t('site.slogan').trim().split(/\s+/);
const sloganPrefix = sloganWords.slice(0, -1).join(' ');
const sloganLast = sloganWords[sloganWords.length - 1];

const trustIcons = [
  'M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', // reloj
  'M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', // globo
  'M12 6v6l4 2M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0Z', // 24/7
  'M9 12l2 2 4-4m5.6 2a8.6 8.6 0 1 1-17.2 0 8.6 8.6 0 0 1 17.2 0Z', // check sello
];

// Íconos por servicio (mismo orden que services.items: personal, ejecutivo,
// eventos, aeropuerto, giras, especiales). Se usan como decoración en el
// placeholder mientras no haya foto real.
const serviceIcons: Record<string, string> = {
  personal:
    'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75', // personas
  ejecutivo:
    'M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM8 6V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1M3 12h18', // maletín
  eventos:
    'M8 2v4M16 2v4M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM3 10h18', // calendario
  aeropuerto:
    'M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z', // avión
  giras:
    'M5 17a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2M5 17h14M4 11h16M8 4v3M16 4v3M7 20v-3M17 20v-3M8 14h.01M16 14h.01', // bus
  especiales:
    'M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z', // destello
};
---

<BaseLayout title={t('nav.home')}>
  <!-- ====== HERO ====== -->
  <section class="relative isolate overflow-hidden bg-ink">
    <HeroSlideshow images={heroImages} class="absolute inset-0 h-full w-full" />
    <!-- Scrim para legibilidad del texto sobre las fotos -->
    <div class="absolute inset-0 bg-gradient-to-r from-ink/90 via-primary/60 to-primary/25" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink/65 via-transparent to-ink/25" aria-hidden="true"></div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 md:px-6 md:py-28 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]"
    >
      <div>
        <p class="font-display text-xs font-bold tracking-[0.2em] text-sun uppercase">{t('home.heroEyebrow')}</p>
        <h1 class="mt-4 max-w-3xl font-display text-4xl leading-tight font-extrabold text-white md:text-6xl">
          {sloganPrefix}{' '}
          <span data-winning class="winning-word text-sun"><span class="winning-ghost">{sloganLast}</span><span class="winning-live" aria-hidden="true">{sloganLast}</span></span>
        </h1>
        <p class="rotator mt-5 font-display text-xl font-bold text-accent md:text-2xl" data-rotator>
          {rotating.map((phrase, i) => <span class:list={[i === 0 && 'is-active']}>{phrase}</span>)}
        </p>
        <p class="mt-5 max-w-xl text-base text-white/85 md:text-lg">{t('home.heroSub')}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="#reserva"
            class="rounded-full bg-action-bright px-7 py-3.5 text-center font-display font-bold text-white shadow-lg shadow-ink/30 transition-all hover:bg-accent hover:text-ink lg:hidden"
          >
            {t('home.heroCtaPrimary')}
          </a>
          <a
            href={localePath(lang, 'services')}
            class="rounded-full border-2 border-white/40 px-7 py-3.5 text-center font-display font-bold text-white transition-colors hover:border-accent hover:text-accent"
          >
            {t('home.heroCtaSecondary')}
          </a>
        </div>
      </div>

      <!-- Mini reserva (estilo Transvip): continúa en la página de contacto -->
      <div id="reserva" class="scroll-mt-24">
        <MiniBookingForm />
      </div>
    </div>
  </section>

  <!-- ====== RESUMEN DE SERVICIOS ====== -->
  <section class="bg-mist py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="reveal max-w-2xl font-display text-3xl font-extrabold text-primary md:text-4xl">
        {t('home.servicesTitle')}
      </h2>
      <p class="reveal mt-3 max-w-xl text-ink/70">{t('home.servicesIntro')}</p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, i) => {
            const photo = serviceImages[service.id];
            return (
              <a
                href={`${localePath(lang, 'services')}#${service.id}`}
                class="svc-card reveal group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-3xl shadow-sm ring-1 ring-white/5 transition-all duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-primary/30 hover:ring-accent/40"
              >
                {/* Fondo: foto real o degradado de marca */}
                <div class="absolute inset-0 transition-transform duration-500 ease-out group-hover:scale-105">
                  {photo ? (
                    <img
                      src={photo}
                      alt={service.title}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <div class="h-full w-full bg-gradient-to-br from-primary via-action to-ink" />
                  )}
                </div>

                {/* Glow de acento que aparece al pasar el mouse */}
                <div
                  class="pointer-events-none absolute -right-8 -top-8 h-36 w-36 rounded-full bg-accent/0 blur-3xl transition-colors duration-500 group-hover:bg-accent/25"
                  aria-hidden="true"
                />

                {/* Overlay para legibilidad del texto */}
                <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/30 to-transparent" />

                {/* Número */}
                <span class="absolute left-5 top-5 font-display text-sm font-bold text-white/70">
                  {String(i + 1).padStart(2, '0')}
                </span>

                {/* Flecha (avanza y se enciende al hover) */}
                <span class="absolute right-5 top-5 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white ring-1 ring-white/20 backdrop-blur transition-all duration-300 group-hover:translate-x-0.5 group-hover:bg-accent group-hover:text-ink">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>

                {/* Contenido */}
                <div class="relative p-6">
                  {/* Ícono prominente (se ilumina y sube al hover) */}
                  <span class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 ring-1 ring-white/15 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:bg-accent/20 group-hover:ring-accent/40">
                    <svg viewBox="0 0 24 24" class="h-6 w-6 stroke-accent transition-transform duration-300 group-hover:scale-110" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={serviceIcons[service.id]} />
                    </svg>
                  </span>
                  <h3 class="font-display text-xl font-bold text-white">{service.title}</h3>
                  {/* Descripción: en táctil/teclado se ve siempre; en escritorio se revela al hover */}
                  <div class="svc-desc">
                    <p class="text-sm text-white/80">{service.text}</p>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>

      <div class="reveal mt-10 text-center">
        <a href={localePath(lang, 'services')} class="font-display font-bold text-action-bright hover:text-primary">
          {t('home.servicesCta')} →
        </a>
      </div>
    </div>
  </section>

  <!-- ====== EXPERIENCIA (paneles parallax / carrusel móvil) ====== -->
  <ExperiencePanels />

  <!-- ====== FRANJA DE CONFIANZA (carrusel infinito tipo "camino") ====== -->
  <section class="bg-primary py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="reveal font-display text-3xl font-extrabold text-white md:text-4xl">{t('home.trustTitle')}</h2>
    </div>

    <div class="marquee reveal mt-10">
      <div class="marquee-track">
        {
          trustLoop.map((item, i) => (
            <div
              class="marquee-card mr-5 w-[17rem] shrink-0 rounded-3xl bg-white/5 p-6 backdrop-blur transition-colors hover:bg-white/10 md:mr-6 md:w-[19rem]"
              aria-hidden={i >= trust.length ? 'true' : undefined}
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sun/15">
                <svg viewBox="0 0 24 24" class="h-6 w-6 stroke-sun" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={trustIcons[i % trustIcons.length]} />
                </svg>
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-white">{item.title}</h3>
              <p class="mt-2 text-sm text-white/75">{item.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ====== LOGOS DE CONVENIOS (placeholders) ====== -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 text-center md:px-6">
      <h2 class="reveal font-display text-2xl font-extrabold text-primary md:text-3xl">{t('home.partnersTitle')}</h2>
      <p class="reveal mt-2 text-xs text-ink/70">{t('home.partnersNote')}</p>
      <ul class="reveal mx-auto mt-8 grid max-w-5xl grid-cols-2 gap-4 sm:grid-cols-3">
        {
          partners.map((partner, i) => (
            <li class="flex h-28 items-center justify-center rounded-2xl border border-primary/10 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
              {partnerLogos[i] ? (
                <img src={partnerLogos[i]} alt={partner} loading="lazy" decoding="async" class="max-h-14 w-auto object-contain" />
              ) : (
                <span class="text-center font-display text-base font-semibold text-primary">{partner}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ====== CTA FINAL → WHATSAPP ====== -->
  <section class="bg-gradient-to-br from-ink to-primary py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 text-center md:px-6">
      <h2 class="reveal font-display text-3xl font-extrabold text-white md:text-4xl">{t('home.finalCtaTitle')}</h2>
      <p class="reveal mt-4 text-white/80">{t('home.finalCtaText')}</p>
      <a
        href={waLink(t('form.waIntroBooking'))}
        target="_blank"
        rel="noopener"
        class="reveal mt-8 inline-flex items-center gap-3 rounded-full bg-wa px-8 py-4 font-display text-lg font-bold text-white shadow-xl shadow-wa/30 transition-transform hover:scale-105"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true"><path d="M12 2a9.9 9.9 0 0 0-8.5 15.1L2 22l5-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1a17 17 0 0 1-1.7-.6c-3-1.3-5-4.4-5.1-4.6-.1-.2-1.2-1.6-1.2-3.1 0-1.5.8-2.2 1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l1 2.3c0 .2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.1.3.7 1.2 1.6 2 1.1 1 2 1.3 2.3 1.4.3.2.5.1.7-.1l.9-1c.2-.3.4-.3.7-.2l2.2 1c.3.2.5.3.6.4.1.2.1.7-.2 1.2Z"/></svg>
        {t('home.finalCtaButton')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Palabra destacada del hero ("ganar"/"winning"). La copia "ghost" (en la
     fuente base) reserva el espacio y la línea base; la copia "live" rota de
     tipografía por encima, en posición absoluta, sin afectar el layout. Si no
     hay JS o se prefiere menos movimiento, se ve la ghost (Sora) normal. */
  .winning-word {
    position: relative;
    display: inline-block;
    font-family: 'Sora', ui-sans-serif, sans-serif;
  }
  .winning-live {
    display: none;
  }

  /* ===== Tarjetas de servicios: descripción que se revela al hover ===== */
  .svc-desc > p {
    padding-top: 0.5rem;
  }
  /* Solo en dispositivos con hover (escritorio) la ocultamos por defecto y la
     revelamos al pasar el mouse o al enfocar con teclado. En táctil se ve. */
  @media (hover: hover) {
    .svc-card .svc-desc {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 0.35s ease,
        opacity 0.35s ease;
    }
    .svc-card .svc-desc > p {
      overflow: hidden;
      min-height: 0;
    }
    .svc-card:hover .svc-desc,
    .svc-card:focus-within .svc-desc {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  /* ===== Carrusel infinito "camino" (franja de confianza) ===== */
  .marquee {
    overflow: hidden;
    /* Desvanece los bordes para que las tarjetas "entren" y "salgan" suave. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    /* La pista tiene 4 tandas iguales. Mover una tanda (25%) hacia la DERECHA
       (de -25% a 0) y reiniciar es invisible, porque el patrón se repite cada
       tanda → loop infinito sin cortes y sin huecos en pantallas anchas. */
    animation: road 24s linear infinite;
    will-change: transform;
  }
  /* Pausa al pasar el mouse */
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes road {
    from {
      transform: translateX(-25%);
    }
    to {
      transform: translateX(0);
    }
  }
  /* Accesibilidad: sin movimiento automático, se puede arrastrar a mano */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-track {
      animation: none;
    }
  }
</style>

<script>
  // Titular rotativo del hero
  const rotator = document.querySelector('[data-rotator]');
  if (rotator) {
    const phrases = rotator.querySelectorAll('span');
    let index = 0;
    setInterval(() => {
      phrases[index]?.classList.remove('is-active');
      index = (index + 1) % phrases.length;
      phrases[index]?.classList.add('is-active');
    }, 2800);
  }

  // Palabra destacada: rota de tipografía sin mover NADA (ni el resto de la
  // página ni la palabra misma). La copia "ghost" (siempre en la fuente base)
  // reserva el espacio y la línea base; la copia "live" flota encima en
  // position:absolute (no afecta el layout) y va cambiando de fuente. Para que
  // tampoco cambie de largo ni de altura, a la live le fijamos:
  //   - el ancho con scaleX (= ancho de la fuente base), y
  //   - la línea base con un offset vertical medido por canvas (ascendente).
  const winning = document.querySelector<HTMLElement>('[data-winning]');
  const ghost = winning?.querySelector<HTMLElement>('.winning-ghost') ?? null;
  const live = winning?.querySelector<HTMLElement>('.winning-live') ?? null;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (winning && ghost && live && !prefersReduced && 'fonts' in document) {
    const fonts = [
      { fam: "'Sora'", stack: "'Sora', sans-serif" },
      { fam: "'Playfair Display'", stack: "'Playfair Display', serif" },
      { fam: "'Bebas Neue'", stack: "'Bebas Neue', sans-serif" },
      { fam: "'Pacifico'", stack: "'Pacifico', cursive" },
      { fam: "'Space Mono'", stack: "'Space Mono', monospace" },
    ];
    const text = live.textContent ?? '';
    const ctx = document.createElement('canvas').getContext('2d');
    let fi = 0;
    const scaleX: number[] = []; // factor de ancho por fuente
    const topOff: number[] = []; // offset vertical (px) para igualar la línea base

    const apply = (i: number) => {
      live.style.fontFamily = fonts[i].stack;
      live.style.transform = `scaleX(${scaleX[i].toFixed(4)})`;
      live.style.top = `${topOff[i].toFixed(2)}px`;
    };

    const measure = () => {
      // La live flota encima de la ghost, sin afectar el layout.
      live.style.position = 'absolute';
      live.style.left = '0';
      live.style.top = '0';
      live.style.display = 'inline-block';
      live.style.whiteSpace = 'nowrap';
      live.style.transformOrigin = 'left center';
      live.style.pointerEvents = 'none';
      ghost.style.color = 'transparent'; // reserva espacio pero no se ve

      const cs = getComputedStyle(ghost);
      const fontHead = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize}`;
      const target = ghost.getBoundingClientRect().width; // ancho de la fuente base

      let baseAscent = 0;
      if (ctx) {
        ctx.font = `${fontHead} ${fonts[0].fam}`;
        baseAscent = ctx.measureText(text).fontBoundingBoxAscent;
      }

      scaleX.length = 0;
      topOff.length = 0;
      for (const f of fonts) {
        live.style.transform = 'none';
        live.style.fontFamily = f.stack;
        const w = live.getBoundingClientRect().width;
        scaleX.push(w ? target / w : 1);

        let off = 0;
        if (ctx && baseAscent) {
          ctx.font = `${fontHead} ${f.fam}`;
          const a = ctx.measureText(text).fontBoundingBoxAscent;
          if (Number.isFinite(a)) off = baseAscent - a;
        }
        topOff.push(off);
      }
      apply(fi);
    };

    const start = async () => {
      const cs = getComputedStyle(ghost);
      // Carga las fuentes (en su peso/tamaño reales) antes de medir.
      await Promise.all(
        fonts.map((f) =>
          document.fonts.load(`${cs.fontWeight} ${cs.fontSize} ${f.fam}`).catch(() => {}),
        ),
      );
      measure();
      setInterval(() => {
        fi = (fi + 1) % fonts.length;
        apply(fi);
      }, 1500);
      // Re-mide si cambia el tamaño (p. ej. al cruzar el breakpoint del título).
      let rt: number | undefined;
      window.addEventListener(
        'resize',
        () => {
          clearTimeout(rt);
          rt = window.setTimeout(measure, 150);
        },
        { passive: true },
      );
    };

    document.fonts.ready.then(start);
  }
</script>
