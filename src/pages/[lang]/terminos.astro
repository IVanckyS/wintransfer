---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout title={t('terms.title')}>
  <section class="bg-primary py-14 md:py-16">
    <div class="mx-auto max-w-3xl px-4 md:px-6">
      <h1 class="font-display text-4xl font-extrabold text-white">{t('terms.title')}</h1>
      <p class="mt-3 text-sm text-white/60">{t('terms.updated')}</p>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-4 md:px-6">
      <p class="rounded-2xl border-2 border-dashed border-primary/20 bg-mist p-6 leading-relaxed text-ink/70">
        {t('terms.body')}
      </p>
    </div>
  </section>
</BaseLayout>
