---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderMedia from '../../components/PlaceholderMedia.astro';
import { useTranslations, localePath, type Lang } from '../../i18n';
import { waLink } from '../../config';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

interface ServiceItem {
  id: string;
  title: string;
  text: string;
  mediaLabel: string;
}
const services = t<ServiceItem[]>('services.items');
---

<BaseLayout title={t('services.title')}>
  <section class="bg-primary py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h1 class="font-display text-4xl font-extrabold text-white md:text-5xl">{t('services.title')}</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/85">{t('services.intro')}</p>
    </div>
  </section>

  <!-- Bloques alternados imagen + texto + botón -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-6xl space-y-16 overflow-x-hidden px-4 md:px-6 md:space-y-20">
      {
        services.map((service, i) => {
          // La imagen entra desde un lado y el texto desde el opuesto, siguiendo
          // la alternancia visual de la página. Reversible vía el observer .reveal.
          const fromLeft = i % 2 === 0;
          const mediaReveal = fromLeft ? 'reveal-left' : 'reveal-right';
          const textReveal = fromLeft ? 'reveal-right' : 'reveal-left';
          return (
            <article
              id={service.id}
              class:list={['grid scroll-mt-24 items-center gap-8 lg:grid-cols-2', i % 2 === 1 && 'lg:[&>*:first-child]:order-2']}
            >
              <PlaceholderMedia label={service.mediaLabel} class={`reveal ${mediaReveal} aspect-[16/10] rounded-3xl`} />
              <div class:list={['reveal', textReveal]}>
                <span class="font-display text-sm font-bold text-action">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="mt-2 font-display text-2xl font-extrabold text-primary md:text-3xl">{service.title}</h2>
                <p class="mt-4 text-ink/70">{service.text}</p>
                <a
                  href={localePath(lang, 'contact')}
                  class="group mt-6 inline-flex items-center gap-1.5 font-display text-sm font-bold text-action-bright transition-colors hover:text-primary"
                >
                  {t('services.ctaCard')}
                  <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="bg-mist py-16">
    <div class="mx-auto max-w-3xl px-4 text-center md:px-6">
      <h2 class="reveal font-display text-2xl font-extrabold text-primary md:text-3xl">{t('services.bottomCtaTitle')}</h2>
      <p class="reveal mt-3 text-ink/70">{t('services.bottomCtaText')}</p>
      <a
        href={waLink()}
        target="_blank"
        rel="noopener"
        class="reveal mt-6 inline-block rounded-full bg-wa px-7 py-3.5 font-display font-bold text-white transition-transform hover:scale-105"
      >
        {t('common.whatsappCta')}
      </a>
    </div>
  </section>
</BaseLayout>
