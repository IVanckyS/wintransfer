---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderMedia from '../../components/PlaceholderMedia.astro';
import { useTranslations, localePath, type Lang } from '../../i18n';


export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

interface Attribute {
  title: string;
  text: string;
}
const attributes = t<Attribute[]>('about.attributes');
---

<BaseLayout title={t('about.title')}>
  <!-- Encabezado -->
  <section class="bg-primary py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h1 class="font-display text-4xl font-extrabold text-white md:text-5xl">{t('about.title')}</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/85">{t('about.intro')}</p>
    </div>
  </section>

  <!-- Historia + misión -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 md:px-6 lg:grid-cols-2">
      <PlaceholderMedia label={t('about.mediaLabel')} class="reveal aspect-[4/3] rounded-3xl" />
      <div class="space-y-8">
        <div class="reveal">
          <h2 class="font-display text-2xl font-extrabold text-primary">{t('about.historyTitle')}</h2>
          <p class="mt-3 text-ink/70">{t('about.historyText')}</p>
        </div>
        <div class="reveal">
          <h2 class="font-display text-2xl font-extrabold text-primary">{t('about.missionTitle')}</h2>
          <p class="mt-3 text-ink/70">{t('about.missionText')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Atributos -->
  <section class="bg-mist py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="reveal font-display text-3xl font-extrabold text-primary md:text-4xl">{t('about.attributesTitle')}</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          attributes.map((attribute) => (
            <div class="reveal rounded-3xl border border-primary/10 bg-white p-6 shadow-sm">
              <span class="block h-1.5 w-10 rounded-full bg-accent" aria-hidden="true" />
              <h3 class="mt-4 font-display text-lg font-bold text-primary">{attribute.title}</h3>
              <p class="mt-2 text-sm text-ink/70">{attribute.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cobertura: CTA a la página dedicada -->
  <section class="bg-ink py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 md:px-6 text-center">
      <h2 class="reveal font-display text-3xl font-extrabold text-white md:text-4xl">{t('about.coverageTitle')}</h2>
      <p class="reveal mt-3 max-w-xl mx-auto text-white/75">{t('about.coverageText')}</p>
      <p class="reveal mt-3 inline-flex items-center gap-2 rounded-full bg-sun/15 px-5 py-2.5 font-display text-sm font-bold text-sun">
        <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        {t('about.coverageBadge')}
      </p>
      <div class="mt-8">
        <a
          href={localePath(lang, 'coverage')}
          class="reveal inline-flex items-center gap-2 rounded-full bg-sun px-7 py-3.5 font-display text-base font-bold text-ink transition hover:bg-sun/85"
        >
          {t('about.coverageCta')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
