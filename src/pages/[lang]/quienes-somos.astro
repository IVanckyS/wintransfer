---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { useTranslations, localePath, type Lang } from '../../i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }, { params: { lang: 'pt' } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

interface Attribute {
  title: string;
  text: string;
}
const attributes = t<Attribute[]>('about.attributes');
const process = t<Attribute[]>('about.process');

// Íconos por paso (mismo orden que about.process)
const processIcons = [
  'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z', // mensaje (cuéntanos)
  'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2m-5 7 1.5 1.5L15 11', // checklist (coordinamos)
  'M5 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0M15 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0M5 17H3v-6l2-5h9l4 5h2v6h-2M9 17h6', // auto (viajas)
];

// Íconos por atributo (mismo orden que about.attributes)
const attributeIcons = [
  'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9.5 12l1.8 1.8L15 10', // escudo + check (seguridad)
  'M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8', // persona (conductores)
  'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', // reloj (puntualidad)
  'M4 14v-2a8 8 0 0 1 16 0v2M5 14a2 2 0 0 0-2 2v1a2 2 0 0 0 2 2h1a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1H5zM19 14a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2h-1a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h1z', // soporte (atención)
  'M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4', // sliders (flexibilidad)
  'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0ZM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', // pin (cobertura)
];
---

<BaseLayout title={t('about.title')}>
  <PageBanner image="/images/hero-van.webp">
    <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
      <div class="md:max-w-lg">
        <p class="font-display text-xs font-bold tracking-[0.2em] text-sun uppercase">{t('about.eyebrow')}</p>
        <h1 class="mt-3 font-display text-4xl font-extrabold text-white md:text-5xl">{t('about.title')}</h1>
        <p class="mt-4 text-lg text-white/85">{t('about.intro')}</p>
      </div>
    </div>
  </PageBanner>

  <!-- Cómo trabajamos -->
  <section class="bg-mist py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="reveal font-display text-3xl font-extrabold text-primary md:text-4xl">{t('about.processTitle')}</h2>
      <ol class="mt-10 grid list-none gap-6 p-0 md:grid-cols-3">
        {
          process.map((step, i) => (
            <li class="reveal rounded-3xl border border-primary/10 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/10">
              <div class="flex items-center gap-3">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-primary font-display text-lg font-extrabold text-white">
                  {i + 1}
                </span>
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/10">
                  <svg
                    viewBox="0 0 24 24"
                    class="h-6 w-6 stroke-accent"
                    fill="none"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d={processIcons[i % processIcons.length]} />
                  </svg>
                </span>
              </div>
              <h3 class="mt-4 font-display text-lg font-bold text-primary">{step.title}</h3>
              <p class="mt-2 text-sm text-ink/70">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Historia + Misión / Visión -->
  <section class="overflow-x-hidden bg-white py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 md:px-6 lg:grid-cols-2 lg:items-start">
      <!-- Historia -->
      <div class="reveal reveal-left">
        <h2 class="font-display text-2xl font-extrabold text-primary md:text-3xl">{t('about.historyTitle')}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink/70">{t('about.historyText')}</p>
        <img
          src="/images/nosotros-historia.webp"
          alt={t('about.historyAlt')}
          loading="lazy"
          decoding="async"
          class="mt-6 aspect-[4/3] w-full rounded-3xl object-cover object-center shadow-sm ring-1 ring-primary/5"
        />
      </div>

      <!-- Misión y Visión -->
      <div class="reveal reveal-right space-y-8 rounded-3xl bg-mist p-8 md:p-10">
        <div class="flex gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/10">
            <svg viewBox="0 0 24 24" class="h-6 w-6 stroke-accent" fill="none" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <circle cx="12" cy="12" r="5" />
              <circle cx="12" cy="12" r="1.5" />
            </svg>
          </span>
          <div>
            <h3 class="font-display text-lg font-bold text-primary">{t('about.missionTitle')}</h3>
            <p class="mt-1.5 leading-relaxed text-ink/70">{t('about.missionText')}</p>
          </div>
        </div>

        <div class="flex gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/10">
            <svg viewBox="0 0 24 24" class="h-6 w-6 stroke-accent" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </span>
          <div>
            <h3 class="font-display text-lg font-bold text-primary">{t('about.visionTitle')}</h3>
            <p class="mt-1.5 leading-relaxed text-ink/70">{t('about.visionText')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Atributos -->
  <section class="bg-mist py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 md:px-6">
      <h2 class="reveal font-display text-3xl font-extrabold text-primary md:text-4xl">{t('about.attributesTitle')}</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          attributes.map((attribute, i) => (
            <div class="reveal rounded-3xl border border-primary/10 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-primary/10">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10">
                <svg
                  viewBox="0 0 24 24"
                  class="h-6 w-6 stroke-accent"
                  fill="none"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={attributeIcons[i % attributeIcons.length]} />
                </svg>
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-primary">{attribute.title}</h3>
              <p class="mt-2 text-sm text-ink/70">{attribute.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cobertura: CTA a la página dedicada -->
  <section class="bg-ink py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 text-center md:px-6">
      <h2 class="reveal font-display text-3xl font-extrabold text-white md:text-4xl">{t('about.coverageTitle')}</h2>
      <p class="reveal mx-auto mt-3 max-w-xl text-white/75">{t('about.coverageText')}</p>
      <p class="reveal mt-3 inline-flex items-center gap-2 rounded-full bg-sun/15 px-5 py-2.5 font-display text-sm font-bold text-sun">
        <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
        {t('about.coverageBadge')}
      </p>
      <div class="mt-8">
        <a
          href={localePath(lang, 'coverage')}
          class="reveal inline-flex items-center gap-2 rounded-full bg-sun px-7 py-3.5 font-display text-base font-bold text-ink transition hover:bg-sun/85"
        >
          {t('about.coverageCta')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
